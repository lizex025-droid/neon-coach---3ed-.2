# ==========================================
# NEON COACH - بيئة التكوين الاختيارية
# ==========================================
# التطبيق يعمل بشكل مستقل 100% بدون أي مفاتيح عبر الوضع التجريبي والمحلي
# إذا أردت ربط مزود ذكاء اصطناعي فعلي (Gemini / OpenAI)، ضع المفاتيح هنا:

# نمط تشغيل الذكاء الاصطناعي: 'mock' (افتراضي وآمن) أو 'gemini' أو 'openai'
VITE_AI_PROVIDER=mock

# مفتاح Google Gemini API (اختياري - لا تضعه في الواجهة العامة المنشورة)
# احصل عليه من: https://aistudio.google.com/
VITE_GEMINI_API_KEY=

# مفتاح OpenAI API (اختياري)
# احصل عليه من: https://platform.openai.com/
VITE_OPENAI_API_KEY=

# نقطة نهاية وسيط أمان مخصص (Backend Proxy Endpoint) إذا أردت إخفاء المفاتيح تماماً
VITE_AI_PROXY_URL=

# ==========================================
# SUPABASE DATABASE & AUTH
# ==========================================
VITE_SUPABASE_URL=https://fqwjcacuxsumqpmdsfxc.supabase.co
VITE_SUPABASE_ANON_KEY=

