# ==========================================
# NEON COACH - بيئة التكوين الاختيارية
# ==========================================
# التطبيق يعمل بشكل مستقل 100% بدون أي مفاتيح عبر الوضع التجريبي والمحلي
# إذا أردت ربط مزود ذكاء اصطناعي فعلي (Gemini / OpenAI)، ضع المفاتيح هنا:

# المزود الافتراضي: auto يحاول Gemini ثم OpenAI كبديل
AI_PROVIDER=auto

# مفاتيح الخادم فقط — لا تستخدم بادئة VITE_ معها
# احصل عليه من: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# احصل عليه من: https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# إعدادات Proxy اختيارية
AI_TIMEOUT_MS=25000
AI_RATE_LIMIT_PER_MINUTE=20

# ==========================================
# SUPABASE DATABASE & AUTH
# ==========================================
VITE_SUPABASE_URL=https://fqwjcacuxsumqpmdsfxc.supabase.co
VITE_SUPABASE_ANON_KEY=
